# Chart pins for the OAN developer stack. Shell syntax; sourced by scripts/*.sh.
# Refresh with `./oan.sh versions` (reads github.com/OpenG2P/versions and the COSS oan-helm index),
# then review the diff and re-render.

# Where the charts come from.
OPENG2P_HELM_REPO=https://openg2p.github.io/openg2p-helm
OAN_HELM_REPO=https://raw.githubusercontent.com/Centre-for-Open-Societal-Systems/oan-helm/main/repository

# Layer 1 — Commons Base: upstream OpenG2P, used unmodified (Postgres, Keycloak, MinIO, Redis, Kafka).
# Latest release candidate in OpenG2P/versions commons/CHANGELOG.md.
COMMONS_BASE_VERSION=2.3.4-rc.247

# Layer 2 — Commons Services: the COSS chart (vendors upstream openg2p-commons-services and adds the
# OAN configuration: Master Data catalogue build, ETH-OAN seed, consent/partner changes, websub).
COMMONS_SERVICES_VERSION=1.0.0-dev.24

# Layer 3 — one registry. COSS wrapper charts around upstream openg2p-registry.
FARMER_VERSION=1.0.0-dev.17
CROP_VERSION=1.0.0-dev.16
LIVE_VERSION=1.0.0-dev.16
DA_VERSION=1.0.0-dev.16

# Tool images used by the renderer (helm + python, built locally from tools/Dockerfile).
HELM_IMAGE=alpine/helm:3.16.4
