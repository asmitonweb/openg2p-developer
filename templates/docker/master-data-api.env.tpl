MASTER_DATA_API_HOST="0.0.0.0"
MASTER_DATA_API_PORT=8000
MASTER_DATA_API_NO_OF_WORKERS=2
MASTER_DATA_API_OPENAPI_ROOT_PATH=/
MASTER_DATA_API_WORKER_TYPE=gunicorn

MASTER_DATA_API_DB_DRIVER="postgresql+asyncpg"
MASTER_DATA_API_DB_HOSTNAME="postgres"
MASTER_DATA_API_DB_PORT=5432
MASTER_DATA_API_DB_USERNAME="postgres"
MASTER_DATA_API_DB_PASSWORD="{{POSTGRES_PASSWORD}}"
MASTER_DATA_API_DB_DBNAME="{{REGISTRY_MASTER_DATA_DB_NAME}}"

# iam-core auth fields are read under MASTER_DATA_API_* (not COMMON_*) since
# master-data-api 1.1.x moved to a single env prefix. Ping stays public.
MASTER_DATA_API_AUTH_ENABLED="false"
MASTER_DATA_API_AUTH_PROVIDER_API_URL="http://iam-staff-api:8000"
MASTER_DATA_API_KEYCLOAK_CLIENT_ID="{{REGISTRY_KEYCLOAK_CLIENT_ID}}"
MASTER_DATA_API_AUTH_REDIS_URL="redis://redis:6379/0"
MASTER_DATA_API_AUTH_VERIFY_SSL="false"
