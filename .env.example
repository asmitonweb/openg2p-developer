# Copy to .env to change defaults. Everything is optional.

# Where registry images come from: ghcr (pull the floating `latest` tag; builds from source when
# an image is not published yet) or local (always build from source).
OAN_IMAGE_SOURCE=ghcr

# ghcr mode only: registry prefix and the tag used for every registry image. OAN tracks `latest`;
# set the 12-character source commit from the oan-helm chart to run exactly what the dev cluster runs.
#OAN_IMAGE_PREFIX=ghcr.io/asmitonweb
#OAN_IMAGE_TAG=latest

# local mode: where source checkouts live (default src/<repo>, cloned on first build) and the
# branch to clone. Point OAN_<REGISTRY>_SRC at your own checkout to build what you are editing.
#OAN_SRC_DIR=../
#OAN_SRC_REF=develop
#OAN_FARMER_SRC=/path/to/farmer-registry
#OAN_CROP_SRC=/path/to/cropsown-regsitry
#OAN_LIVE_SRC=/path/to/livestock-registry

# Extra `docker build` flags for local builds, e.g. --no-cache or --build-arg RP_VERSION=1.2.2-rc.557
#OAN_BUILD_ARGS=

# Seconds to wait for a seed/init job before giving up (default 900).
#JOB_TIMEOUT=900
