# Copy to .env to change defaults. Everything is optional; `./oan.sh select` and `./oan.sh dev`
# write OAN_COMPONENTS and OAN_IMAGE_SOURCE here for you.

# What `./oan.sh up` runs: component ids from scripts/components.sh (./oan.sh components lists them).
#OAN_COMPONENTS="farmer farmer-dashboard-api farmer-dashboard"

# Where the OAN images come from: ghcr (pull the floating `latest` tag; builds from source when an
# image is not published yet) or local (always build from the checkouts in oan-workspace/).
#OAN_IMAGE_SOURCE=ghcr

# ghcr mode only: registry prefix and the tag used for every OAN image. OAN tracks `latest`; set
# the 12-character source commit from the oan-helm chart to run exactly what the dev cluster runs.
#OAN_IMAGE_PREFIX=ghcr.io/asmitonweb
#OAN_IMAGE_TAG=latest

# Where the source checkouts live (default oan-workspace/<repo>, cloned from COSS by `oan.sh up`)
# and the branch to clone. Point OAN_<ID>_SRC (component id upper-cased, '-' -> '_') or
# OAN_<REPO>_SRC (repository name, for the repo consent-manager and consent-partner-portal share)
# at your own checkout. The shell always wins over this file.
#OAN_SRC_DIR=../
#OAN_SRC_REF=develop
#OAN_FARMER_SRC=/path/to/farmer-registry
#OAN_CROP_SRC=/path/to/cropsown-regsitry
#OAN_LIVE_SRC=/path/to/livestock-registry
#OAN_CONSENT_MANAGEMENT_SRC=/path/to/consent-management

# Extra `docker build` flags for local builds, e.g. --no-cache or --build-arg RP_VERSION=1.2.2-rc.557
#OAN_BUILD_ARGS=

# Seconds to wait for a seed/init job before giving up (default 900).
#JOB_TIMEOUT=900

# Plain output (no colours, no in-place progress lines), e.g. for logs.
#OAN_PLAIN=1
